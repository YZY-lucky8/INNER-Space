# INNERSCAPE server · 环境变量样例（只提交占位值，真实 .env 不入库）
# 复制为 server/.env 后按需修改；启动时集中校验，配置不合法直接快速失败。

# ---- 服务 ----
NODE_ENV=development
PORT=8787
# 显式来源，逗号分隔；生产禁止通配符
CORS_ORIGINS=http://localhost:8765,http://127.0.0.1:8765

# ---- MySQL 8（复用 database/ 下的课程设计脚本）----
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
# 本机 root 无密码时留空即可；生产必须设置强密码
DB_PASSWORD=
DB_NAME=innerspace
DB_POOL_SIZE=10

# ---- JWT ----
# 生产必须替换为长随机串（例如 openssl rand -hex 32）。
# development 下若仍为占位值，进程内生成临时密钥并告警（重启后令牌失效，仅用于本地开发）。
JWT_ACCESS_SECRET=CHANGE_ME
JWT_REFRESH_SECRET=CHANGE_ME
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=604800

# ---- 邮箱验证码 ----
# development：验证码写入结构化日志并在响应里返回 devCode（不会冒充"已发邮件"）。
# production：必须配置 SMTP_URL，否则 OTP 接口返回 503，明确报错而不是静默假成功。
OTP_TTL=300
OTP_MAX_ATTEMPTS=5
SMTP_URL=
# RBAC：逗号分隔的管理员邮箱，其余账号一律 user（可留空）
ADMIN_EMAILS=

# ---- 服务端 LLM（OpenAI 兼容）----
# 留空时 /api/v1/diagnose 与 /api/v1/diagnose/actions 返回 AI_DISABLED，前端静默降级到规则引擎。
# 密钥只在服务端，前端永不接触。
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_MS=15000
