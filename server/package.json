{
  "name": "innerspace-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "INNERSCAPE 卡点 · 离线优先全栈后端（Express + MySQL 8）",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "check": "node scripts/check-syntax.mjs",
    "db:init": "node scripts/init-db.mjs",
    "db:migrate": "node scripts/migrate.mjs",
    "test": "node --test tests/*.test.mjs",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.12.0",
    "zod": "^3.24.1"
  }
}
